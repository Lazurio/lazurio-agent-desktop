{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lazurio Agent Desktop",
  "mainBinaryName": "lazurio-agent-desktop",
  "version": "0.1.0",
  "identifier": "io.lazurio.agent-desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Lazurio Agent Desktop",
        "width": 400,
        "height": 640,
        "minHeight": 420,
        "resizable": true,
        "maximizable": false,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Lazurio",
    "license": "Elastic-2.0",
    "category": "Utility",
    "shortDescription": "Lets agents of your Lazurio Environment use the apps on this computer while you allow it.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "resources/agent-desktop-LICENSE": "agent-desktop-LICENSE"
    },
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-",
      "hardenedRuntime": true,
      "entitlements": "Entitlements.plist"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
